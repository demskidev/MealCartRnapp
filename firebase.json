{
  "functions": [
    {
      "source": "functions"
    }
  ],
  "hosting": {
    "public": "hosting",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/kroger/callback",
        "function": "krogerOAuthCallback"
      }
    ]
  }
}
